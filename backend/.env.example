# Copy this file to `.env` and fill in your values.

# --- Database (MariaDB / MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aura_chat
DB_USER=root
DB_PASS=

# --- Google Gemini (free key: https://aistudio.google.com/apikey) ---
# Leave empty to use the built-in offline empathy engine.
GEMINI_API_KEY=
# Models are tried in order; the next one is used if one is busy or unavailable.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite
# Optional path to a CA bundle (cacert.pem) if HTTPS calls fail with SSL errors.
# On Windows the system certificate store is used automatically.
CA_BUNDLE=

# --- App ---
# Comma separated list of allowed CORS origins, or * for any (fine for local dev)
CORS_ORIGINS=*
TOKEN_TTL_DAYS=30
APP_DEBUG=true
